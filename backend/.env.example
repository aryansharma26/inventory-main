JWT_REFRESH_EXPIRATION=7d

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
